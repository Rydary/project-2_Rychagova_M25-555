[0.000013, "o", "update - <имя_таблицы> set <столбец1> = <новое_значение1> where <столбец_условия> = <значение_условия> - обновить запись.\r\ndelete - from <имя_таблицы> where <столбец> = <значение> - удалить запись.\r\ninfo - <имя_таблицы> - вывести информацию о таблице.\r\n"]
